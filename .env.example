# ── Google OAuth (Gmail API) ──────────────────────────────────────────────────
# Setup: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GMAIL_CLIENT_SECRET="YOUR_GMAIL_CLIENT_SECRET"
GMAIL_REFRESH_TOKEN="YOUR_GMAIL_REFRESH_TOKEN"

# ── Zapier integration ────────────────────────────────────────────────────────
# Secret header value Zapier sends when posting to /api/zapier/hook
ZAPIER_WEBHOOK_SECRET="YOUR_RANDOM_SECRET"
# Permanent Catch Hook URL from Zapier (Trigger: Webhooks by Zapier → Catch Hook)
ZAPIER_CATCH_HOOK_URL="https://hooks.zapier.com/hooks/catch/XXXXXXXX/XXXXXXXX/"

# ── App URL ───────────────────────────────────────────────────────────────────
# After deploying to Railway, set this to your Railway public URL.
# Used by the Android app to reach the backend.
# Example: https://market-session-watch-production.up.railway.app
VITE_API_URL="https://YOUR-APP.up.railway.app"
